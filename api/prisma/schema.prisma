generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// manager solo consulta. admin también escribe.
enum Role {
  admin
  manager
}

/// Hash scrypt. No hay contraseña en claro.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(255)
  passwordHash String
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("user")
}

/// Sin nombre: el CSV no lo trae. El código se guarda en mayúsculas.
model Category {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(32)
  subcategories   Subcategory[]
  pendingProducts Product[]    @relation("DeclaredCategory")

  @@map("category")
}

/// Único en todo el catálogo para que no pertenezca a dos categorías.
model Subcategory {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique @db.VarChar(32)
  categoryId String    @db.Uuid
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@index([categoryId])
  @@map("subcategory")
}

/// Texto, no número: conserva el cero inicial. El Id del CSV no se guarda.
/// needsAttention: la fila se guardó, pero hay que revisarla.
/// subcategoryId queda vacío solo si el CSV no trae subcategoría. En ese caso categoryId conserva la categoría declarada.
model Product {
  id              String       @id @default(uuid()) @db.Uuid
  upcCode         String       @unique @db.VarChar(12)
  upcDescription  String
  subcategoryId   String?      @db.Uuid
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  categoryId      String?      @db.Uuid
  category        Category?    @relation("DeclaredCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  needsAttention  Boolean      @default(false)
  attentionReason String?
  dateAdded       DateTime?    @db.Timestamptz(6)
  updatedDate     DateTime?    @db.Timestamptz(6)
  addedBy         String       @db.VarChar(255)
  modifiedBy      String       @db.VarChar(255)

  @@index([subcategoryId])
  @@index([categoryId])
  @@map("product")
}
